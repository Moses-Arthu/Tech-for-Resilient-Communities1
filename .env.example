# ─────────────────────────────────────────────────────────────────────────────
# Resilient Ghana — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and replace the values with your actual Firebase project keys:
# cp .env.example .env
#
# If left blank or unconfigured, the app will automatically run in Offline/Local Mode
# storing accounts and authentication state locally in your browser.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Configuration (https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FCM_SERVER_KEY=

# Cloud AI Models (Optional)
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=

# WebSocket Server (Optional)
VITE_SOCKET_URL=http://localhost:3001
